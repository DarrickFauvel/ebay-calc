<td id="rate-<%= it.cell.id %>" class="<%= it.cell.edited ? 'edited' : '' %> <%= it.saved ? 'saved' : '' %>">
  <input type="number" inputmode="decimal" min="0" step="0.01" value="<%= Number(it.cell.price).toFixed(2) %>"
         aria-label="<%= it.cell.max_oz %> oz, zone <%= it.cell.zone %>"
         data-on:change="@post('/rates/<%= it.cell.id %>', {payload: {price: el.value}})">
</td>
