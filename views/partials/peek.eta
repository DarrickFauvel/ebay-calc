<a id="peek" class="peek" href="#results">
<% const q = it.q %>
<% if (q.error) { %>
  <span class="peek-label">Enter weight to price</span>
<% } else if (q.input.mode === 'profit') { %>
  <span class="peek-label">List at</span><strong data-flash="peek"><%= it.usd(q.result.charm) %></strong><span class="peek-meta">pad <%= it.usd(q.result.shipPad) %> · see breakdown</span>
<% } else { %>
  <span class="peek-label">Profit</span><strong data-flash="peek" class="<%= q.result.profit < 0 ? 'loss' : '' %>"><%= it.usd(q.result.profit) %></strong><span class="peek-meta"><%= it.pct(q.result.margin) %> margin · see breakdown</span>
<% } %>
<% if (!q.error) { const i = q.input %>
  <span class="peek-pkg" data-flash="pkg"><%= [it.weight(i.weightOz), i.length ? `${i.length}×${i.width}×${i.height} in` : '', i.shipZip.length === 5 ? `to ${i.shipZip}` : '', `label ${it.usd(q.best.price)}`].filter(Boolean).join(' · ') %></span>
<% } %>
</a>
