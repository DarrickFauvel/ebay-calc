<% layout('./layout') %>
<%/* First in <main> so it can stick to the top in the side panel; on phones it's fixed to the bottom. */%>
<%~ include('./partials/peek', { q: it.q, usd: it.usd, pct: it.pct, weight: it.weight }) %>
<div class="calc-layout">
  <form id="calc" class="card"
        data-signals="<%= JSON.stringify(it.signals) %>"
        data-on:input__debounce.250ms="@post('/calc')"
        data-on:submit__prevent="@post('/calc')"
        data-indicator="_busy">
    <h1>Price with free shipping</h1>
<% if (!it.settings.origin_zip) { %>
    <p class="notice">Using zone <%= it.settings.usps_zone %> as the worst case. <a href="/settings">Set your ZIP (where you ship from)</a> to compute your actual furthest lower-48 zone.</p>
<% } %>

    <%/* eBay first: in the side panel, the package comes from eBay. The box is revealed by the Chrome extension. */%>
    <div id="ebay-sync" class="notice" hidden>
      <span id="ebay-sync-text" data-flash="ebay"></span>
    </div>

    <fieldset class="segmented">
      <legend>I want to…</legend>
      <label><input type="radio" name="mode" value="profit" data-bind="mode"> Find my price</label>
      <label><input type="radio" name="mode" value="price" data-bind="mode"> Check a price</label>
    </fieldset>

    <div class="field-grid">
      <label class="field">
        <span>Item cost</span>
        <span class="affix" data-prefix="$"><input type="number" inputmode="decimal" min="0" step="0.01" data-bind="cost"></span>
      </label>
      <label class="field" data-show="$mode === 'profit'">
        <span>Target profit</span>
        <span class="affix" data-prefix="$"><input type="number" inputmode="decimal" step="0.01" data-bind="targetProfit"></span>
      </label>
      <div class="field" data-show="$mode === 'price'">
        <label for="list-price">List price</label>
        <span class="affix" data-prefix="$"><input id="list-price" type="number" inputmode="decimal" min="0" step="0.01" data-bind="listPrice"></span>
        <div class="stepper">
          <button type="button" class="secondary" aria-label="Lower list price by $1" data-on:click="$listPrice = Math.max(0, (+$listPrice || 0) - 1).toFixed(2); @post('/calc')">−$1</button>
          <button type="button" class="secondary" aria-label="Raise list price by $1" data-on:click="$listPrice = ((+$listPrice || 0) + 1).toFixed(2); @post('/calc')">+$1</button>
        </div>
      </div>
      </div>
      <label class="field span-all">
        <span>eBay category</span>
        <select data-bind="categoryId">
<% for (const c of it.categories) { %>
          <option value="<%= c.id %>"><%= c.name %> (<%= c.fvf_pct %>%)</option>
<% } %>
        </select>
      </label>
    </div>

    <%/* Mostly filled from eBay, so it stays closed; the summary shows what's in it. */%>
    <details class="package">
      <summary>Package &amp; shipping <span class="summary-meta" data-text="[(+$lb || 0) + ' lb ' + (+$oz || 0) + ' oz', +$length ? $length + '×' + $width + '×' + $height + ' in' : '', $shipZip ? 'to ' + $shipZip : '', $labelCost ? 'label $' + $labelCost : 'label estimated'].filter(Boolean).join(' · ')"></span></summary>
      <fieldset>
        <legend>Packed weight</legend>
        <div class="field-grid">
          <span class="affix" data-suffix="lb"><input type="number" inputmode="numeric" min="0" max="70" step="1" aria-label="Pounds" data-bind="lb"></span>
          <span class="affix" data-suffix="oz"><input type="number" inputmode="decimal" min="0" max="15.99" step="0.1" aria-label="Ounces" data-bind="oz"></span>
        </div>
      </fieldset>
      <fieldset>
        <legend>Box size</legend>
        <p class="hint">Needed for UPS, and for USPS boxes over 1 cubic foot.</p>
        <div class="field-grid dims">
          <span class="affix" data-prefix="L" data-suffix="in"><input type="number" inputmode="decimal" min="0" step="0.5" aria-label="Length, inches" data-bind="length"></span>
          <span class="affix" data-prefix="W" data-suffix="in"><input type="number" inputmode="decimal" min="0" step="0.5" aria-label="Width, inches" data-bind="width"></span>
          <span class="affix" data-prefix="H" data-suffix="in"><input type="number" inputmode="decimal" min="0" step="0.5" aria-label="Height, inches" data-bind="height"></span>
        </div>
      </fieldset>
      <div class="field-grid">
        <label class="field">
          <span>Ship to ZIP</span>
          <input type="text" inputmode="numeric" pattern="\d{5}" maxlength="5" autocomplete="off" placeholder="Optional" data-bind="shipZip">
        </label>
        <label class="field">
          <span>eBay label cost</span>
          <span class="affix" data-prefix="$"><input type="number" inputmode="decimal" min="0" step="0.01" placeholder="Optional" data-bind="labelCost"></span>
        </label>
        <label class="field">
          <span>Buyer sales tax</span>
          <span class="affix" data-suffix="%"><input type="number" inputmode="decimal" min="0" max="20" step="0.01" data-bind="taxPct"></span>
        </label>
      </div>
      <p class="hint">eBay label cost is eBay's USPS Ground Advantage price. Leave it empty to estimate from the rate table.</p>
<%~ include('./partials/ship-to', { dest: it.q.dest }) %>
    </details>
    <noscript><button type="submit">Calculate</button></noscript>
  </form>

<%~ include('./partials/results', { q: it.q, settings: it.settings, usd: it.usd, pct: it.pct, weight: it.weight }) %>
</div>
