<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= it.title %> · Ship Pad</title>
  <meta name="description" content="Price, comp and list on eBay without losing money on shipping.">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#ebebeb" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1c1c1c" media="(prefers-color-scheme: dark)">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <link rel="preload" href="/fonts/barlow-semi-condensed-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/app.css">
  <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@1.0.4/bundles/datastar.js"></script>
  <script type="module" src="/js/app.js"></script>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">
      <img src="/icons/icon.svg" alt="" width="28" height="28">
      <span>Ship Pad</span>
      <small class="version">v<%= it.version %></small>
    </a>
    <nav class="tabbar" aria-label="Main">
<% const icons = {
  calc: 'M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm1 3v3h8V6ZM8 12h2m2 0h2m2 0h0M8 15h2m2 0h2m2 0v3M8 18h2m2 0h2',
  settings: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.4-3a7.4 7.4 0 0 0-.1-1.2l2-1.6-2-3.4-2.4 1a7.6 7.6 0 0 0-2-1.2L14.5 3h-5l-.4 2.6a7.6 7.6 0 0 0-2 1.2l-2.4-1-2 3.4 2 1.6a7.4 7.4 0 0 0 0 2.4l-2 1.6 2 3.4 2.4-1a7.6 7.6 0 0 0 2 1.2l.4 2.6h5l.4-2.6a7.6 7.6 0 0 0 2-1.2l2.4 1 2-3.4-2-1.6c.1-.4.1-.8.1-1.2Z',
  categories: 'M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8ZM7.5 7.5h0'
} %>
<% for (const [href, key, label] of [['/', 'calc', 'Calculator'], ['/categories', 'categories', 'Fees'], ['/settings', 'settings', 'Settings']]) { %>
      <a href="<%= href %>"<% if (it.nav === key) { %> aria-current="page"<% } %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="<%= icons[key] %>"/></svg>
        <span><%= label %></span>
      </a>
<% } %>
    </nav>
  </header>
  <p class="offline-banner" role="status" hidden>You're offline. Showing the last loaded page; calculations resume when you reconnect.</p>
  <main>
<%~ it.body %>
  </main>
</body>
</html>
