{
  "manifest_version": 3,
  "name": "Ship Pad: copy from eBay",
  "version": "0.5.3",
  "description": "Price, comp and list on eBay without losing money on shipping: sold comps on search, listing-editor shortcuts and the shipping calculator, linked to Ship Pad.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "userScripts"
  ],
  "host_permissions": [
    "https://www.ebay.com/shp/calc/*",
    "https://www.ebay.com/lstng*",
    "https://www.ebay.com/sch/*",
    "http://localhost:3000/*",
    "https://ship-pad.darrickdevelops.com/*",
    "https://*.app.github.dev/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ship Pad"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://ship-pad.darrickdevelops.com/*",
        "https://*.app.github.dev/*"
      ],
      "js": [
        "fill.js",
        "content.js"
      ],
      "all_frames": true
    }
  ]
}
